# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://username:password@ep-example.us-east-2.aws.neon.tech/snowfall?sslmode=require

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Encryption (32-byte hex for AES-256-GCM SMTP credential encryption)
ENCRYPTION_KEY=replace_with_64_hex_character_key

# S3 / Cloudflare R2 Storage (Optional attachments)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=snowfall-resumes
AWS_ENDPOINT=

# Inngest (Background execution)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
